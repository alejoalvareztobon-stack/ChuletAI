{
  "name": "chuletai",
  "productName": "ChuletAI",
  "version": "0.1.0",
  "description": "Live AI copilot for interviews and calls on Windows: real-time transcription and suggested answers.",
  "main": "./out/main/index.js",
  "author": "alejoalvareztobon-stack",
  "repository": {
    "type": "git",
    "url": "https://github.com/alejoalvareztobon-stack/ChuletAI.git"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "selftest": "electron-vite build && electron . --selftest",
    "build": "electron-vite build && electron-builder --win --x64",
    "build:dir": "electron-vite build && electron-builder --win --x64 --dir",
    "selftest:live": "electron-vite build && electron . --selftest --live",
    "screenshots": "electron-vite build && electron . --selftest --screenshots"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "@google/genai": "^3.6.1",
    "unpdf": "^1.9.1",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.7",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
